{
  "name": "eyestruct",
  "version": "1.0.0",
  "description": "Eyes for production agents: deterministic look / look-diff with a committed visual memory (labs/.eyes/) that CI can gate. Process-per-look; the only surviving state is git state.",
  "license": "MIT",
  "type": "commonjs",
  "homepage": "https://docs.creadev.org/eyestruct",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaupin/eyestruct.git"
  },
  "bugs": {
    "url": "https://github.com/dhaupin/eyestruct/issues"
  },
  "bin": {
    "eyestruct": "bin/eyestruct.js"
  },
  "files": [
    "bin",
    "lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./lib/index.js": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "npm test && npm run check",
    "lint:docs": "node scripts/check-docs-frontmatter.cjs && node scripts/check-docs-links.cjs && node scripts/check-docs-style.cjs && node scripts/check-fiction-signatures.cjs && node scripts/check-jekyll-filters.cjs",
    "check": "npm run check:trifecta && npm run lint:docs && npm run packs && npm run lint:packs && npm run conform:packs",
    "check:trifecta": "node scripts/check-trifecta.cjs",
    "packs": "node scripts/run-packs.cjs",
    "lint:packs": "node bin/eyestruct.js lint-packs --deep",
    "conform:packs": "packstruct audit-conformance . --loader \"node scripts/run-packs.cjs {packs}\"",
    "raster:gate": "node bin/eyestruct.js raster docs/icon.svg web/public/icon.svg",
    "check:browser": "node scripts/check-browser.mjs",
    "build:web": "npm run build --prefix web",
    "eyestruct": "node bin/eyestruct.js"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "crashtest": "^1.1.0",
    "freestruct": "^1.1.0",
    "packstruct": "1.0.0"
  },
  "dependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
