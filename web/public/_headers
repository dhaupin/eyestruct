/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-XSS-Protection: 0

  # CSP notes:
  # - script-src: Cloudflare Insights (remove if not using)
  # - connect-src: 'self', Cloudflare Insights, raw.githubusercontent.com (the
  #   gate-status island reads this repo's file over the GitHub raw host), and
  #   the family member origins the family-status island fetches cross-origin
  #   (docs/status.md, family-status@1). connect-src governs fetch() BEFORE any
  #   CORS header matters: a missing sibling here is "Failed to fetch" with the
  #   sibling's ACAO never consulted (eyestruct#25). Must be a superset of
  #   FamilyStatusIsland's SIBLINGS minus self; monoforge is listed ahead of
  #   joining the grid (crashtest already carries it), so the origin is already
  #   reachable the day its row lands. tests/status.test.js pins the subset.
  # - style-src / font-src: includes Google Fonts (remove if not using)
  # - Tighten or expand each directive to match your actual asset sources.
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com https://raw.githubusercontent.com https://crashtest.creadev.org https://poststruct.creadev.org https://packstruct.creadev.org https://govstruct.creadev.org https://monoforge.creadev.org; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

# the family status dialect (family-status@1, docs/status.md): the served
# file is meant to be read CROSS-ORIGIN by every member's status page and
# by any agent. ACAO on the miss path too - a not-yet member must read as
# an honest HTTP 404 at the reader, never an opaque network failure.
/status.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json
  Cache-Control: no-cache
